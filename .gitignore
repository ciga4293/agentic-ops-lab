# Environment secrets & local credentials
.env
.env.local
.env.*.local

# Databases
*.db
*.sqlite
*.sqlite3

# Staging & sensitive data
data/staging/*
workflows/office-ops/input/*
!workflows/office-ops/input/.gitkeep
workflows/office-ops/staging/*
!workflows/office-ops/staging/.gitkeep
workflows/office-ops/output/*
!workflows/office-ops/output/.gitkeep

# Logs & caches
logs/
*.log
cache/
.cache/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
